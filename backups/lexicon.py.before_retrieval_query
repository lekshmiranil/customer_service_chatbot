def canon(word):
    """A spelling-tolerant form of a Latin-letter word: lower case, w=v, aspirates and doubled letters collapsed.
    It is applied to the cue lists and to the customer's words, so 'paisaa', 'paisa' and 'pysa'-like variants meet."""
    value = str(word).lower().replace("'", "").replace("\u2019", "")
    value = value.replace("w", "v")
    for old in ("kh", "gh", "th", "dh", "bh"):
        value = value.replace(old, old[0])
    for old, new in (("ee", "i"), ("oo", "u"), ("ii", "i"), ("uu", "u")):
        value = value.replace(old, new)
    return re.sub(r"(.)\1+", r"\1", value)


def is_native_text(text):
    return any(ord(char) > 0x024F for char in str(text))


_KEYWORDS = None


def english_keywords():
    """English words that appear in the English cue lists (weaker language evidence than function words)."""
    global _KEYWORDS
    if _KEYWORDS is None:
        found = set()
        for cues in INTENT_CUES.values():
            cue = cues.get("en")
            if not cue:
                continue
            words = cue["w"].split()
            for phrase in cue["p"]:
                words.extend(phrase.split())
            for word in words:
                low = word.lower()
                if low not in FUNCTION_WORDS:
                    found.add(low)
        _KEYWORDS = found
    return _KEYWORDS


