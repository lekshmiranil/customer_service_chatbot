"""Language detection for one message. Plain Python, no model. Native script tokens are strong evidence, Roman letter
cue words are weaker evidence, so mixed-language and transliterated messages work. Entities are masked before this runs."""
import difflib
import unicodedata

from src.multilingual import lexicon

SCRIPT_RANGES = {
    "hi": (0x0900, 0x097F), "ta": (0x0B80, 0x0BFF), "te": (0x0C00, 0x0C7F),
    "kn": (0x0C80, 0x0CFF), "ml": (0x0D00, 0x0D7F),
}
EDGE = ".,;:!?\"'()[]{}<>|/\\-_*~`\u201c\u201d\u2018\u2019\u0964\u0965\u2026"
_ROMAN_CACHE = {}


def supported_languages(cfg):
    return [code for code in cfg.get("languages", []) if code in lexicon.LANG_NAMES]


def tokens(text):
    """Whitespace tokens with punctuation removed from both ends. Inner characters are kept (ORD-1, don't)."""
    out = []
    for raw in unicodedata.normalize("NFC", str(text or "")).split():
        value = raw.strip(EDGE)
        if value:
            out.append(value)
    return out


def _char_script(char):
    code = ord(char)
    for name, (low, high) in SCRIPT_RANGES.items():
        if low <= code <= high:
            return name
    if char.isalpha():
        return "latin" if code <= 0x024F else "other"
    return None


def token_script(token):
    """'latin', a language code for an Indic script, 'other', or None when the token has no letters."""
    counts = {}
    for char in token:
        script = _char_script(char)
        if script:
            counts[script] = counts.get(script, 0) + 1
    if not counts:
        return None
    return max(counts, key=lambda name: (counts[name], name != "latin"))


def _roman_index(supported):
    key = tuple(supported)
    cached = _ROMAN_CACHE.get(key)
    if cached is not None:
        return cached
    table = {}
    for lang in supported:
        if lang == "en":
            continue
        words = set(lexicon.ROMAN_WORDS.get(lang, "").split())
        for cues in lexicon.INTENT_CUES.values():
            cue = cues.get(lang)
            if cue:
                words.update(cue["w"].split())
                for phrase in cue["p"]:
                    words.update(phrase.split())
        for word in words:
            low = word.lower()
            if lexicon.is_native_text(low) or low in lexicon.FUNCTION_WORDS or low in lexicon.english_keywords():
                continue
            table.setdefault(lexicon.canon(low), set()).add(lang)
    _ROMAN_CACHE[key] = table
    return table


def roman_cues(token, supported, cutoff=0.8):
    """(language, weight) pairs for one Latin-letter token. English function words 1.0, English cue words 0.5,
    Roman Hindi/Malayalam/Tamil/Telugu/Kannada cue words 1.5 shared between the languages that use the word."""
    low = token.lower()
    if "en" in supported:
        if low in lexicon.FUNCTION_WORDS:
            return [("en", 1.0)]
        if low in lexicon.english_keywords():
            return [("en", 0.5)]
    table = _roman_index(supported)
    key = lexicon.canon(low)
    langs = table.get(key)
    if langs:
        return [(lang, 1.5 / len(langs)) for lang in sorted(langs)]
    if len(key) >= 5:
        for near in difflib.get_close_matches(key, list(table), n=3, cutoff=cutoff):
            if near[0] == key[0] and abs(len(near) - len(key)) <= 2:
                langs = table[near]
                return [(lang, 1.2 / len(langs)) for lang in sorted(langs)]
    return []


def detect(text, cfg, session_language=""):
    """Returns language, confidence (0..1), evidence, mixed, languages, inherited and scores. 'unknown' means an
    unsupported script dominates. With no usable evidence the session language is inherited."""
    supported = supported_languages(cfg)
    thr = cfg.get("thresholds", {})
    default = cfg.get("default_language", "en")
    cutoff = float(thr.get("fuzzy_cutoff", 0.8))
    scores = {lang: 0.0 for lang in supported}
    unsupported = 0.0
    letters = 0
    for token in tokens(text):
        script = token_script(token)
        if script is None:
            continue
        letters += 1
        if script == "latin":
            for lang, weight in roman_cues(token, supported, cutoff):
                scores[lang] += weight
        elif script in scores:
            scores[script] += 2.5
        else:
            unsupported += 2.5
    supported_total = sum(scores.values())
    total = supported_total + unsupported
    ranked = sorted((lang for lang in scores if scores[lang] > 0), key=lambda lang: -scores[lang])
    result = {"language": default, "confidence": 0.0, "evidence": 0.0, "mixed": False,
              "languages": ranked, "inherited": False, "scores": scores, "unsupported": unsupported}
    fallback = session_language if session_language in supported else ""
    if letters == 0 or total == 0:
        if letters == 0 or fallback:
            result.update(language=fallback or default, confidence=0.7, inherited=True)
        else:
            result.update(language=default, confidence=0.65 if letters >= 2 else 0.4)
        return result
    top_score = max(scores.values()) if scores else 0.0
    tied = [lang for lang in scores if scores[lang] > 0 and scores[lang] >= 0.9 * top_score]
    top = session_language if session_language in tied else max(scores, key=lambda lang: scores[lang])
    if unsupported >= scores.get(top, 0.0):
        result.update(language="unknown", confidence=0.0)
        return result
    coverage = supported_total / total
    confidence = coverage * (1.0 - 0.4 ** supported_total)
    if ranked == ["en"] and unsupported == 0 and confidence < 0.62:
        confidence = 0.62  # only English evidence and nothing contradicting it
    ordered = sorted(scores.values(), reverse=True)
    second = ordered[1] if len(ordered) > 1 else 0.0
    share = float(thr.get("mixed_second_share", 0.25))
    result.update(language=top, confidence=round(confidence, 3), evidence=scores[top],
                  mixed=second >= 1.0 and second >= share * supported_total)
    return result


def language_by_name(text, supported):
    """A language the customer named in a very short message ('Tamil', 'हिन्दी'), else None."""
    found = tokens(text)
    if not found or len(found) > 3:
        return None
    for token in found:
        lang = lexicon.NAME_WORDS.get(token.lower())
        if lang and lang in supported:
            return lang
    return None