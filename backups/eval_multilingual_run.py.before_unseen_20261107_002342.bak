         {"text": "and the refund?", "at": 20, "c": "custR", "expect": {"status": "active", "notice": ""}},
         {"text": "hello", "at": 55, "c": "custR", "expect": {
             "status": "restored", "notice": "restored", "notice_has": "ORD-11111"}},
         {"text": "hello", "at": 1555, "c": "custR", "expect": {"status": "new", "notice": "expired_new"}},
     ]},
    {"id": "isolation", "title": "Two customers at the same time", "turns": [
        {"s": "A", "c": "custA", "text": "where is my order ORD-10001", "at": 0, "expect": {
            "query_has": ["ORD-10001"]}},
        {"s": "B", "c": "custB", "text": "where is my order ORD-20002", "at": 1, "expect": {
            "query_has": ["ORD-20002"]}},
        {"s": "A", "c": "custA", "text": "and the refund?", "at": 2, "expect": {
            "query_has": ["ORD-10001"], "query_lacks": ["ORD-20002"], "last_order": "ORD-10001"}},
        {"s": "B", "c": "custB", "text": "and the refund?", "at": 3, "expect": {
            "query_has": ["ORD-20002"], "query_lacks": ["ORD-10001"], "last_order": "ORD-20002"}},
    ]},
]


def judge(result, state, expect):
    if not result.get("ok"):
        return ["bridge returned ok False (%s)" % result.get("error")]
    inner = result.get("result") or {}
    slots = (state or {}).get("slots") or {}
    problems = []

    def want(label, actual, expected):
        if actual != expected:
            problems.append("%s: expected %s, got %s" % (label, ascii(expected), ascii(actual)))

    for key in ("kind", "language", "status", "notice", "switched", "mixed", "escalated"):
        if key in expect:
            want(key, result.get(key), expect[key])
    for key in ("reason", "resolved_from"):
        if key in expect:
            want(key, inner.get(key), expect[key])
    for intent in expect.get("intents", []):
        if intent not in (result.get("intents") or []):
            problems.append("intent %s missing, got %s" % (ascii(intent), ascii(result.get("intents"))))
    query = result.get("query") or ""
    for part in expect.get("query_has", []):
        if part not in query:
            problems.append("query lacks %s, query was %s" % (ascii(part), ascii(query)))
    for part in expect.get("query_lacks", []):
        if part in query:
            problems.append("query contains %s, query was %s" % (ascii(part), ascii(query)))
    if "notice_has" in expect and expect["notice_has"] not in (result.get("notice_text") or ""):
        problems.append("notice text lacks %s" % ascii(expect["notice_has"]))
    orders = slots.get("order_ids") or []
    if "last_order" in expect:
        want("last_order", orders[-1] if orders else "", expect["last_order"])
    if "name" in expect:
        want("name", slots.get("name", ""), expect["name"])
    if "turns_min" in expect and (result.get("turns") or 0) < expect["turns_min"]:
        problems.append("turns: expected at least %s, got %s" % (expect["turns_min"], result.get("turns")))
    return problems


def load_state(db, session_id):
    conn = None
    try:
        conn = session_store.connect(db)
        row = session_store.get_session(conn, session_id)
        return (row or {}).get("state") or {}
    except Exception:
        return {}
    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass


def run_conversation(conv, cfg, base):
    tmp = tempfile.mkdtemp()
    db = os.path.join(tmp, "eval.db")
    active = {}
    rows = []
    try:
        for number, turn in enumerate(conv["turns"], 1):
            text = str(turn.get("text", ""))
            key = str(turn.get("s", "main"))
            requested = active.get(key) or "eval_%s_%s" % (conv["id"], key)
            try:
                when = base + timedelta(minutes=float(turn.get("at", number)))
                result = bridge.handle_turn(
                    requested, str(turn.get("c", "")), text, now=when, cfg=cfg, db_path=db)
            except Exception as exc:
                result = {"ok": False, "error": type(exc).__name__}
            if result.get("ok"):
                active[key] = result["session_id"]
            state = load_state(db, result.get("session_id"))
            problems = judge(result, state, turn.get("expect") or {})
            rows.append({"n": number, "text": text, "problems": problems})
    except Exception as exc:
        rows.append({"n": 0, "text": "(conversation error)", "problems": [type(exc).__name__ + ": " + str(exc)]})
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return {
        "id": conv["id"], "title": conv.get("title", ""), "rows": rows,
        "passed": bool(rows) and all(not row["problems"] for row in rows),
    }


def load_user():
    if not os.path.exists(USER_FILE):
        return None, USER_FILE + " not found"
    try:
        with open(USER_FILE, encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception as exc:
        return None, "could not read: %s: %s" % (type(exc).__name__, exc)
    if isinstance(data, dict):
        data = data.get("conversations")
    if not isinstance(data, list):
        return None, "expected a list of conversations"
    good = []
    for number, conv in enumerate(data, 1):
        if isinstance(conv, dict) and isinstance(conv.get("turns"), list) and conv["turns"]:
            conv.setdefault("id", "user_%02d" % number)
            good.append(conv)
    return good, "%d of %d conversations usable" % (len(good), len(data))


def score(results):
    turns = sum(len(r["rows"]) for r in results)
    turns_ok = sum(1 for r in results for row in r["rows"] if not row["problems"])
    return sum(1 for r in results if r["passed"]), len(results), turns_ok, turns


def describe(results):
    lines = []
    for res in results:
        lines.append("### %s: %s - %s" % (res["id"], res["title"], "PASS" if res["passed"] else "FAIL"))
        lines.append("")
        lines.append("| # | message | result |")
        lines.append("|---|---------|--------|")
        for row in res["rows"]:
            outcome = "ok" if not row["problems"] else "; ".join(row["problems"])
            lines.append("| %s | %s | %s |" % (row["n"], row["text"].replace("|", "/"), outcome.replace("|", "/")))
        lines.append("")
    return lines


def main():
    cfg = config.get_config()
    base = session_store.utc_now()
    built = [run_conversation(conv, cfg, base) for conv in BUILT_IN]
    user_convs, user_note = load_user()
    user = [run_conversation(conv, cfg, base) for conv in user_convs] if user_convs else None

    lines = ["# Multilingual evaluation", "",
             "Simulated clock, temporary databases, no model, no quota. Two separate scores.", "",
             "## Scores", "", "| Set | Conversations passed | Turn checks passed |", "|-----|------|------|"]
    cp, ct, tp, tt = score(built)
    lines.append("| Assistant-written (written after seeing the code, NOT blind) | %d/%d | %d/%d |" % (cp, ct, tp, tt))
    if user is not None:
        up, ut, utp, utt = score(user)
        lines.append("| User-written (unseen by the assistant) | %d/%d | %d/%d |" % (up, ut, utp, utt))
    else:
        lines.append("| User-written (unseen by the assistant) | not run | not run |")
    lines += ["", "User file: " + user_note, "",
              "Expectations in the assistant-written set were chosen by the assistant, so a high score there "
              "does not show how the layer behaves on unseen conversations. The user-written set is the "
              "meaningful one.", "", "## Assistant-written conversations", ""]
    lines += describe(built)
    if user is not None:
        lines += ["## User-written conversations", ""]
        lines += describe(user)

    with open(OUT_FILE, "w", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")

    for label, results in (("assistant-written", built), ("user-written", user or [])):
        for res in results:
            print(("ok   " if res["passed"] else "FAIL ") + label + " " + res["id"])
            for row in res["rows"]:
                for problem in row["problems"]:
                    print("       turn %s: %s" % (row["n"], problem))
    print("assistant-written: %d/%d conversations, %d/%d turn checks" % (cp, ct, tp, tt))
    if user is not None:
        print("user-written: %d/%d conversations, %d/%d turn checks" % (up, ut, utp, utt))
    else:
        print("user-written: not run (" + user_note + ")")
    print("report written to", OUT_FILE)


main()