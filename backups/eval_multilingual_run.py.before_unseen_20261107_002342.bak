"""Multilingual evaluation with a simulated clock.

Runs 15 built-in conversations (written by the assistant that wrote the code, so
they are NOT blind) and the conversations in eval_user_conversations.json
(written by the user, unseen by the assistant). Writes eval_results_multilingual.md
with two separate scores. Uses temporary databases, no model and no quota.
"""

import json
import os
import shutil
import sys
import tempfile
from datetime import timedelta

sys.stdout.reconfigure(errors="backslashreplace")

from src.multilingual import bridge, config, session_store

OUT_FILE = "eval_results_multilingual.md"
USER_FILE = "eval_user_conversations.json"
TAMIL = "\u0b8e\u0ba9\u0bcd \u0b86\u0bb0\u0bcd\u0b9f\u0bb0\u0bcd \u0b8e\u0b99\u0bcd\u0b95\u0bc7"


def _context_turns():
    messages = [
        "where is my order ORD-66666", "hello", "thanks", "and the refund?",
        "hello", "thanks", "mera order kab aayega", "hello", "thanks",
        "where is my order", "hello", "and the refund?",
    ]
    turns = [{"text": text, "at": number} for number, text in enumerate(messages)]
    turns[0]["expect"] = {"kind": "query", "intents": ["order_status"], "query_has": ["ORD-66666"]}
    turns[6]["expect"] = {"kind": "query", "intents": ["order_status"], "query_has": ["ORD-66666"]}
    turns[11]["expect"] = {
        "kind": "query", "intents": ["refund"], "query_has": ["ORD-66666"],
        "last_order": "ORD-66666", "turns_min": 24,
    }
    return turns


