"""Dialogue flow for the multilingual layer (no database, no model).

handle_message(state, text, cfg) takes the session state dict and one customer
message and returns (new_state, result). The bridge stores turns and state.
Standard library only.
"""

import copy

from src.multilingual import entities
from src.multilingual import intents as intent_rules
from src.multilingual import languages, lexicon, replies, summary

ORDER_KEYS = ("order_ids", "order_id", "order", "orders")
PRODUCT_KEYS = ("product_codes", "product_code", "product", "products")
DATE_KEYS = ("dates", "date")
NAME_KEYS = ("names", "name")

SOCIAL = tuple(getattr(lexicon, "SOCIAL", ("greeting", "thanks")))

_EXTRA = {
    "updated": {
        "en": "Noted, I have updated the details to {value}.",
        "hi": "ठीक है, मैंने जानकारी बदलकर {value} कर दी है।",
        "ml": "ശരി, വിവരങ്ങൾ {value} ആയി പുതുക്കിയിട്ടുണ്ട്.",
        "ta": "சரி, விவரங்களை {value} என்று புதுப்பித்துள்ளேன்.",
        "te": "సరే, వివరాలను {value} గా నవీకరించాను.",
        "kn": "ಸರಿ, ವಿವರಗಳನ್ನು {value} ಎಂದು ನವೀಕರಿಸಿದ್ದೇನೆ.",
    },
}
for _key, _table in _EXTRA.items():
    replies.TEXT.setdefault(_key, _table)


def _int(value, fallback=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


def _float(value, fallback=0.0):
    try:
        return float(value)
    except (TypeError, ValueError):
        return fallback


def _as_list(value):
    if isinstance(value, (list, tuple)):
        return list(value)
    return []


def _unique(values):
    out = []
    for value in values:
        if value not in out:
            out.append(value)
    return out


def _values(source, keys):
    out = []
    if not isinstance(source, dict):
        return out
    for key in keys:
        value = source.get(key)
        if value is None:
            continue
        if not isinstance(value, (list, tuple)):
            value = [value]
        for item in value:
            if isinstance(item, dict):
                item = item.get("value", "")
            item = str(item).strip()
            if item and item not in out:
                out.append(item)
    return out


def _found_items(found):
    if isinstance(found, dict):
        return list(found.get("items") or [])
    return list(found or [])


def _current(found):
    out = {
        "order_ids": _values(found, ORDER_KEYS),
        "product_codes": _values(found, PRODUCT_KEYS),
        "dates": _values(found, DATE_KEYS),
        "names": _values(found, NAME_KEYS),
    }
    if any(out.values()):
        return out
    for item in _found_items(found):
        if not isinstance(item, dict):
            continue
        kind = str(item.get("type", ""))
        value = str(item.get("value", "")).strip()
        if not value:
            continue
        if kind.startswith("order"):
            out["order_ids"].append(value)
        elif kind.startswith("product"):
            out["product_codes"].append(value)
        elif kind.startswith("date"):
            out["dates"].append(value)
        elif kind.startswith("name"):
            out["names"].append(value)
    return out


def _masked(text, items):
    try:
        out = entities.mask(text, items)
        if isinstance(out, (tuple, list)) and out:
            out = out[0]
        return out if isinstance(out, str) else text
    except Exception:
        return text


def _update_slots(slots, found, correction):
    try:
        new_slots, changes = entities.update_slots(slots, found, correction=correction)
        return new_slots, _as_list(changes)
    except Exception:
        try:
            new_slots, changes = entities.update_slots(
                slots, _found_items(found), correction=correction
            )
            return new_slots, _as_list(changes)
        except Exception:
            return slots, []


def _blank(kind, lang):
    return {
        "kind": kind,
        "language": lang,
        "languages": [],
        "mixed": False,
        "language_confidence": 0.0,
        "switched": False,
        "previous_language": "",
        "intents": [],
        "entities": {"order_ids": [], "product_codes": [], "dates": [], "names": []},
        "changes": [],
        "query": "",
        "queries": [],
        "text": "",
        "notices": [],
        "reason": "",
        "escalated": False,
        "resolved_from": "",
        "unknown_clauses": 0,
    }


def _query(intent, current, slots, known_order):
    base = str(lexicon.CANONICAL_QUERY.get(intent, "")).strip()
    if not base:
        return ""
    extras = []
    if known_order:
        extras.append("Order ID: " + known_order + ".")
    products = current["product_codes"] or _values(slots, PRODUCT_KEYS)
    if products:
        extras.append("Product code: " + ", ".join(products[-2:]) + ".")
    if current["dates"]:
        extras.append("Date: " + ", ".join(current["dates"]) + ".")
    return " ".join([base] + extras)


def handle_message(state, text, cfg, force_language=""):
    """Process one customer message. Returns (new_state, result)."""
    return _handle(state, text, cfg, force_language)


def _handle(state, text, cfg, force_language):
    state = copy.deepcopy(state) if isinstance(state, dict) else summary.empty_state("en")
    text = str(text or "").strip()
    thr = cfg["thresholds"]
    max_requests = max(1, _int(cfg.get("max_requests"), 3))
    need_order = set(cfg.get("intents_need_order") or [])
    supported = languages.supported_languages(cfg)
    history = _int(state.get("message_count")) + _int(state.get("carried_messages")) > 0
    session_lang = str(state.get("language") or "") if history else ""
    slots = state.get("slots") if isinstance(state.get("slots"), dict) else entities.empty_slots()
    awaiting = str(state.get("awaiting") or "")

    if not text:
        lang = force_language or session_lang or "en"
        result = _blank("clarify", lang)
        result["reason"] = "empty"
        result["text"] = replies.render("clarify_intent", lang)
        return state, result

    # The customer is answering "which language?".
    if awaiting == "language" and not force_language:
        picked = languages.language_by_name(text, supported)
        if isinstance(picked, (list, tuple)):
            picked = picked[0] if picked else ""
        picked = str(picked or "")
        if picked in supported:
            held = str(state.get("held_text") or "")
            state["awaiting"] = ""
            state["held_text"] = ""
            state["language"] = picked
            if held:
                return _handle(state, held, cfg, picked)
            result = _blank("social", picked)
            result["text"] = replies.render("greeting", picked)
            state["message_count"] = _int(state.get("message_count")) + 1
            state["languages"] = _unique(_as_list(state.get("languages")) + [picked])
            return state, result

    found = entities.extract(text, cfg)
    items = _found_items(found)
    current = _current(found)
    masked = _masked(text, items)

    det = languages.detect(text, cfg, session_language=force_language or session_lang)
    det_lang = str(det.get("language") or "unknown")
    conf = _float(det.get("confidence"))
    langs = [code for code in _as_list(det.get("languages")) if isinstance(code, str)]
    if not langs:
        langs = [force_language or session_lang or "en"]

    analysis = intent_rules.analyze(masked, langs, thr)
    words = _int(analysis.get("word_count"))
    short = words <= _int(thr.get("followup_max_words"), 5)
    inherit_cap = _float(thr.get("inherit_confidence"), 0.75)
    requests = [r for r in _as_list(analysis.get("requests")) if isinstance(r, dict)]
    social_only = bool(requests) and all(r.get("intent") in SOCIAL for r in requests)
    unsupported = bool(det.get("unsupported"))

    # Language decision.
    inherited = False
    if force_language:
        lang = force_language
    elif unsupported or det_lang == "unknown":
        lang = ""
    elif (session_lang and short and det_lang != session_lang
            and conf < inherit_cap and not det.get("mixed")):
        lang = session_lang
        inherited = True
    elif conf >= _float(thr.get("language_confidence"), 0.6):
        lang = det_lang
    elif session_lang and short:
        lang = session_lang
        inherited = True
    elif social_only:
        lang = det_lang
    else:
        lang = ""
    if not lang and social_only and not unsupported:
        lang = session_lang or "en"
    if not lang:
        reply_lang = session_lang or "en"
        result = _blank("clarify", reply_lang)
        result["reason"] = "unsupported_language" if unsupported else "low_language_confidence"
        result["languages"] = list(langs)
        result["language_confidence"] = conf
        result["text"] = replies.render("clarify_language", reply_lang)
        state["awaiting"] = "language"
        state["held_text"] = text
        return state, result

    switched = bool(session_lang and lang != session_lang and not force_language and not inherited)
    seen = (lang,) + (tuple(langs) if det.get("mixed") else ())
    notices = []
    marker = bool(analysis.get("correction"))
    correction = marker and any(current.values())
    slots_new, changes = _update_slots(slots, found, correction)
    if correction and changes:
        flat = current["order_ids"] + current["product_codes"] + current["dates"] + current["names"]
        notices.append(replies.render("updated", lang, value=flat[0]))
    known_order = (_values(slots_new, ORDER_KEYS) or current["order_ids"] or [""])[-1]

    def make(kind):
        result = _blank(kind, lang)
        result.update(
            languages=list(langs),
            mixed=bool(det.get("mixed")),
            language_confidence=conf,
            switched=switched,
            previous_language=session_lang if switched else "",
            entities=current,
            changes=changes,
            notices=list(notices),
            unknown_clauses=_int(analysis.get("unknown")),
        )
        return result

    def finish(result, pending=None, awaiting_value="", intents_done=None, overflow=None, unclear=False):
        state["unclear_count"] = _int(state.get("unclear_count")) + 1 if unclear else 0
        state["slots"] = slots_new
        state["message_count"] = _int(state.get("message_count")) + 1
        state["language"] = lang
        state["languages"] = _unique(_as_list(state.get("languages")) + list(seen))
        state["awaiting"] = awaiting_value
        state["held_text"] = ""
        if pending is not None:
            state["pending"] = list(pending)
        if overflow is not None:
            state["open_requests"] = list(overflow)
        if intents_done is not None:
            state["last_intents"] = list(intents_done)
            state["intents_handled"] = _unique(
                _as_list(state.get("intents_handled")) + list(intents_done)
            )
        return state, result

    def ask_between(first, second, reason):
        result = make("clarify")
        result["reason"] = reason
        result["intents"] = [first, second]
        result["text"] = replies.clarify_between(first, second, lang)
        return finish(result, awaiting_value="intent")

    def ask_intent(reason):
        limit = max(2, _int(thr.get("unclear_before_handoff"), 2))
        if _int(state.get("unclear_count")) + 1 >= limit:
            result = make("handoff")
            result["intents"] = ["human_agent"]
            result["escalated"] = True
            result["reason"] = "repeated_unclear"
            result["query"] = str(lexicon.CANONICAL_QUERY.get("human_agent", ""))
            result["text"] = replies.render("handoff", lang)
            return finish(result, pending=[], intents_done=["human_agent"], overflow=[])
        result = make("clarify")
        result["reason"] = reason
        result["text"] = replies.render("clarify_intent", lang)
        return finish(result, awaiting_value="intent", unclear=True)

    strong = [
        r for r in requests
        if _float(r.get("score")) >= _float(thr.get("intent_confidence"), 0.5)
    ]
    found_intents = _unique([str(r.get("intent")) for r in strong])
    real = [i for i in found_intents if i not in SOCIAL]
    social = [i for i in found_intents if i in SOCIAL]
    pending = [i for i in _as_list(state.get("pending")) if isinstance(i, str)]
    last = [i for i in _as_list(state.get("last_intents")) if isinstance(i, str)]

    if "human_agent" in real:
        result = make("handoff")
        result["intents"] = ["human_agent"]
        result["escalated"] = True
        result["query"] = str(lexicon.CANONICAL_QUERY.get("human_agent", ""))
        result["text"] = replies.render("handoff", lang)
        return finish(result, pending=[], intents_done=["human_agent"], overflow=[])

    if social and not real and not (pending and current["order_ids"]):
        result = make("social")
        result["intents"] = [social[0]]
        result["text"] = replies.render(social[0], lang)
        return finish(result)

    pairs = [p for p in _as_list(analysis.get("ambiguous")) if isinstance(p, (list, tuple)) and len(p) >= 2]
    if pairs:
        return ask_between(pairs[0][0], pairs[0][1], "ambiguous_intent")

    resolved_from = ""
    has_entity = any(current.values())
    if real:
        if pending and current["order_ids"]:
            real = _unique(pending + real)
            resolved_from = "pending"
    else:
        if pending and (has_entity or analysis.get("yes") or short):
            real = list(pending)
            resolved_from = "pending"
        elif last and short and (analysis.get("followup") or has_entity):
            if len(last) > 1:
                return ask_between(last[0], last[1], "ambiguous_followup")
            real = list(last)
            resolved_from = "followup"
        elif lang == "en" and words >= _int(thr.get("general_question_min_words"), 4) and not requests:
            result = make("query")
            result["reason"] = "general_question"
            result["query"] = text
            result["queries"] = [text]
            return finish(result, pending=[], intents_done=[], overflow=[])
        else:
            return ask_intent("low_intent_confidence" if requests else "no_intent")

    overflow = real[max_requests:]
    real = real[:max_requests]
    if overflow:
        notices.append(replies.render("too_many", lang, count=max_requests))

    if any(i in need_order for i in real) and not known_order:
        result = make("clarify")
        result["reason"] = "missing_order_id"
        result["intents"] = list(real)
        result["text"] = replies.render("ask_order_id", lang)
        return finish(result, pending=real, awaiting_value="order_id", overflow=overflow)

    def build_query(intent):
        own_words = (
            intent == "product_info"
            and lang == "en"
            and len(real) == 1
            and words >= _int(thr.get("general_question_min_words"), 4)
        )
        if own_words:
            return text
        return _query(intent, current, slots_new, known_order if intent in need_order else "")

    queries = [q for q in (build_query(i) for i in real) if q]
    if not queries:
        return ask_intent("no_query")

    result = make("query")
    result["intents"] = list(real)
    result["queries"] = queries
    result["query"] = " ".join(queries)
    result["resolved_from"] = resolved_from
    result["text"] = " ".join(x for x in (replies.lead_line(i, lang) for i in real) if x)
    return finish(result, pending=[], intents_done=real, overflow=overflow)
